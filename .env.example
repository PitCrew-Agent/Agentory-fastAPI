# ==============================================
# Agentory 환경 변수 (.env로 복사해서 사용)
#   cp .env.example .env
# 비밀키 커밋 절대 금지 (요구사항 §11)
# ==============================================

# 실행 환경: local | dev | prod
APP_ENV=local
LOG_LEVEL=INFO

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://agentory:agentory@localhost:5432/agentory

# --- LLM (OpenAI), 역할별 모델 선택: 비우면 LLM_MODEL 사용 ---
OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_ROUTER_MODEL=gpt-5-mini
LLM_ROUTER_REASONING_EFFORT=minimal
LLM_FINALIZER_MODEL=

# --- Agent ---
AGENT_MAX_STEPS=10
AGENT_GROUNDING_ENABLED=true
AGENT_SUGGESTIONS_ENABLED=true

# --- 임베딩 ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- MCP 서버 ---
MCP_REALTIME_URL=http://localhost:8101/mcp
MCP_KNOWLEDGE_URL=http://localhost:8102/mcp

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=agentory
REFRESH_TOKEN_TTL_SECONDS=1209600
AUDIT_LOG_DB_ENABLED=true
AUDIT_LOG_REDIS_ENABLED=true
AUDIT_LOG_REDIS_TTL_SECONDS=2592000
AUDIT_LOG_REDIS_MAX_STREAM_LENGTH=10000

# --- 인증 / OIDC (Keycloak) ---
OIDC_PROVIDER=oidc
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8000/docs
OIDC_SCOPES=openid profile email offline_access
OIDC_PASSWORD_RESET_URL=
AUTH_STATE_TTL_SECONDS=300
AUTH_AUTO_PROVISION_ENABLED=false
AUTH_DEFAULT_ROLE=field_engineer
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
