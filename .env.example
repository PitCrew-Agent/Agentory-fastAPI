# Agentory ?섍꼍 蹂??(.env濡?蹂듭궗?댁꽌 ?ъ슜)
#   cp .env.example .env
# 鍮꾨???而ㅻ컠 ?덈? 湲덉? (?붽뎄?ы빆 짠11)
# ==============================================

# ?ㅽ뻾 ?섍꼍: local | dev | prod
APP_ENV=local
LOG_LEVEL=INFO

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://agentory:agentory@localhost:5432/agentory

# --- LLM (OpenAI), 역할별 모델 선택: 비우면 LLM_MODEL 사용 ---
OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_ROUTER_MODEL=gpt-5-nano
LLM_FINALIZER_MODEL=

# --- Agent ---
AGENT_MAX_STEPS=10
AGENT_GROUNDING_ENABLED=true

# --- Redis cache ---
REDIS_URL=redis://localhost:6379/0

# --- ?꾨쿋??---
EMBEDDING_MODEL=
EMBEDDING_DIM=1536

# --- MCP ?쒕쾭 ---
MCP_REALTIME_URL=http://localhost:8101/mcp
MCP_KNOWLEDGE_URL=http://localhost:8102/mcp

# --- ?몄쬆 / OIDC (Keycloak) ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=

# --- Azure AD / Microsoft Entra ID SSO ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8000/api/v1/auth/azure/callback
AZURE_AUTHORITY=
ADMIN_EMAILS=admin@example.com
PASSWORD_RESET_HELP_URL=https://passwordreset.microsoftonline.com/

# --- JWT ---
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
