# ==============================================
# Agentory 환경 변수 (.env로 복사해서 사용)
#   cp .env.example .env
# 비밀키 커밋 절대 금지 (요구사항 §11)
# ==============================================

# 실행 환경: local | dev | prod
APP_ENV=local
LOG_LEVEL=INFO
# 요청 액세스 로그(메서드·경로·상태·소요시간) 활성화
ACCESS_LOG_ENABLED=true

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://agentory:agentory@localhost:5432/agentory

# --- LLM (OpenAI), 역할별 모델 선택: 비우면 LLM_MODEL 사용 ---
OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_ROUTER_MODEL=gpt-5-mini
LLM_ROUTER_REASONING_EFFORT=minimal
LLM_WORKER_REASONING_EFFORT=minimal
# 오케스트레이터 Planner 자율 도구 선택용, minimal은 매뉴얼 검색 누락으로 low 권장
LLM_PLANNER_REASONING_EFFORT=low
LLM_FINALIZER_REASONING_EFFORT=low
LLM_FINALIZER_MODEL=
# 최종 답변 토큰 상한(0=무제한)
LLM_FINALIZER_MAX_TOKENS=0

# --- Agent ---
AGENT_MAX_STEPS=6
# 인사·잡담 등 데이터 수집 불필요 질의를 규칙으로 Finalizer 직행 (#139)
AGENT_FAST_ROUTER_ENABLED=true
# 하이브리드 오케스트레이터(단일 ReAct 에이전트 + 병렬 Fetch), 기본 on, 되돌림 시 false (#139)
AGENT_ORCHESTRATOR_ENABLED=true
# Planner 재판단(ReAct) 라운드 예산 (#139)
AGENT_FETCH_ROUNDS_MAX=3
AGENT_GROUNDING_ENABLED=false
AGENT_SUGGESTIONS_ENABLED=true
# 도구 관찰값 프롬프트 재주입 상한(문자수), 초과분은 잘라 컨텍스트 초과 방지
AGENT_TOOL_OBSERVATION_MAX_CHARS=40000
# 멀티턴 history 로드 상한(최근 N개)
AGENT_HISTORY_MAX_MESSAGES=12

# --- 임베딩 ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- RAG 매뉴얼 검색 (BE_MCP04_RAG01) ---
RAG_SEARCH_TOP_K=3
RAG_SEARCH_MIN_SCORE=0.2

# --- MCP 서버 ---
MCP_REALTIME_URL=http://localhost:8101/mcp
MCP_KNOWLEDGE_URL=http://localhost:8102/mcp
MCP_MAINTENANCE_URL=http://localhost:8103/mcp
# 센서 로그 단일 조회 최대 행수, 초과 시 최근 행 우선 반환
SENSOR_LOG_MAX_ROWS=500
# 수리 후 시뮬레이터가 정상 강제하는 힐 윈도우(분), 경과 후 원래 시나리오 재개
SIM_REPAIR_HEAL_MINUTES=60
# 알림 동기화 워처 주기(초), 클라이언트 접속과 무관하게 알람을 알림 테이블로 동기화
NOTIFICATION_SYNC_INTERVAL_SECONDS=5.0

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=agentory
REFRESH_TOKEN_TTL_SECONDS=1209600
AUDIT_LOG_DB_ENABLED=true
AUDIT_LOG_REDIS_ENABLED=true
AUDIT_LOG_REDIS_TTL_SECONDS=2592000
AUDIT_LOG_REDIS_MAX_STREAM_LENGTH=10000

# --- 인증 / OIDC (Azure AD) ---
# AZURE_AD_TENANT_ID / AZURE_AD_CLIENT_ID / AZURE_AD_CLIENT_SECRET 만 채우면
# OIDC_ISSUER_URL / OIDC_CLIENT_ID / OIDC_CLIENT_SECRET 는 자동 유도 (core/config.py)
# 다른 IdP 사용 시 OIDC_* 를 직접 지정
OIDC_PROVIDER=oidc
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8000/docs
# 콜백 후 브라우저가 복귀할 프론트 URL (id_token은 URL fragment로 전달)
FRONTEND_REDIRECT_URI=http://localhost:5173/dashboard
# 프론트 SPA API 호출 허용 오리진, 콤마 구분 다중 지정
CORS_ALLOW_ORIGINS=http://localhost:5173
OIDC_SCOPES=openid profile email offline_access
OIDC_PASSWORD_RESET_URL=
AUTH_STATE_TTL_SECONDS=300
AUTH_AUTO_PROVISION_ENABLED=false
AUTH_DEFAULT_ROLE=field_engineer
AUTH_SESSION_COOKIE_NAME=agentory_session
AUTH_SESSION_TTL_SECONDS=1209600
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# 이상 감지 스코어러 (BE_ANOM01_SERVE01), 모델 적재 후 ENABLED=true
ANOMALY_DETECTION_ENABLED=false
ANOMALY_SCORE_INTERVAL_SECONDS=30
ANOMALY_WINDOW_TICKS=12
ANOMALY_STRIDE_TICKS=6
ANOMALY_CONFIRM_K=2
ANOMALY_EWMA_ALPHA=0.1
ANOMALY_EWMA_CLIP=3.0
ANOMALY_LOOKBACK_ROWS=300
